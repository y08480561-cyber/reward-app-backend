{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reward-backend",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reward-app-db",
      "database_id": "YOUR_D1_DATABASE_ID_TO_BE_LINKED_FROM_CF_DASHBOARD"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
