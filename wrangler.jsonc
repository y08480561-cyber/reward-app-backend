{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reward-app-backend",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reward-app-db",
      "database_id": "a5662c6f-c952-4200-8403-a55640b02498"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "alias": {
    "iconv-lite": "./server/cloudflare/stubs/iconv-lite.js",
    "raw-body": "./server/cloudflare/stubs/raw-body.js",
    "body-parser": "./server/cloudflare/stubs/body-parser.js",
    "multer": "./server/cloudflare/stubs/multer.js"
  }
}
