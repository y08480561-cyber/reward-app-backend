# 'Reqabat Va Jayezah' Server Configuration
# ======================================================

# 1. Server Environment
PORT=3000
NODE_ENV=production

# 2. Database (Supabase PostgreSQL)
# For Render/Standard Node.js, use the Connection Pooler URI (port 6543)
DATABASE_URL=postgres://postgres.xxxxxx:[YOUR_PASSWORD]@aws-0-xxxxxx.pooler.supabase.com:6543/postgres

# 3. Admin Security
# Security key for accessing admin API and dashboard
ADMIN_KEY=ReqabatAdmin2026

# 4. Static Assets & Uploads
# Path to persistent storage for uploads if not using Supabase Storage
# On a standard host, ensure this directory has write permissions
UPLOAD_DIR=./public/uploads

# 5. Supabase Storage (Optional but Recommended for Persistence)
# If provided, the server will attempt to upload images to Supabase Storage
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 6. Tapsell / Ad Configuration (Used by server for verification logic)
TAPSELL_KEY=sgedhqdbofphgpajkrqtahjkedbkokdlqiesotcmfqcklbamjaaiddqsqnihdtmobfidcb
TAPSELL_REWARDED_ZONE_ID=6ad231b89140ba2215e772db
