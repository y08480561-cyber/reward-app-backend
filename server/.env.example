# 'Reqabat Va Jayezah' Server Configuration
# ======================================================

# 1. Server Environment
PORT=3000
NODE_ENV=production

# 2. Database (Supabase PostgreSQL)
# For Render/Standard Node.js, use the Connection Pooler URI (port 6543)
DATABASE_URL=postgres://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 3. Admin Security
# MANDATORY: Security key for accessing admin API and dashboard.
# If not set, the admin panel will be inaccessible.
ADMIN_KEY=your_very_secure_admin_key_here

# 4. Static Assets & Uploads
# Path to local storage for uploads.
UPLOAD_DIR=./public/uploads

# 5. Supabase Storage (Highly Recommended for Persistence)
# If provided, the server will attempt to upload images to Supabase Storage.
# You must create a bucket named 'gift-banners' in Supabase Storage.
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 6. Tapsell / Ad Configuration (Used by server for verification logic)
TAPSELL_KEY=your_tapsell_app_key
TAPSELL_REWARDED_ZONE_ID=your_tapsell_zone_id
