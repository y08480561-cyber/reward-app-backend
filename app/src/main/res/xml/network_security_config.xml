<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Cleartext traffic is strictly disabled, system CA certificates trusted -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific configuration for Render backend domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">reward-app-backend-a9ze.onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
