# ====================================================================
# تنظیمات اتصال به Supabase و تپسل (نمونه متغیرهای محیطی)
# این مقادیر را با اطلاعات واقعی پروژه Supabase خود مقداردهی کنید.
# ====================================================================

# ۱. آدرس پروژه رایگان Supabase (از منوی Settings > API در پنل Supabase)
SUPABASE_URL=https://your-project-id.supabase.co

# ۲. کلید عمومی Anon Key (قابل استفاده در اپلیکیشن اندروید و کلاینت)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ۳. کلید محرمانه مدیر (فقط در پنل مدیریت خصوصی استفاده شود - هرگز در APK قرار نگیرد)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ۴. مشخصات تپسل (در برنامه اندروید اعمال شده است)
