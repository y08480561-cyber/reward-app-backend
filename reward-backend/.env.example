# ======================================================
# تنظیمات محیطی سرور «رقابت کن، جایزه ببر» (Node.js 22)
# ======================================================

# ۱. پورت و محیط اجرایی
PORT=3000
NODE_ENV=production

# ۲. پایگاه داده ابری Supabase PostgreSQL
# توجه: برای هاست اشتراکی و سرورهای بدون IPv6، اکیداً از Transaction Pooler (پورت 6543) استفاده کنید
DATABASE_URL=postgres://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ۳. امنیت پنل مدیریت (الزامی - غیرقابل حدس و حداقل ۳۲ کاراکتر)
ADMIN_KEY=your_very_secure_admin_key_here

# ۴. پین اختیاری ورود کاربران (اختیاری - در صورت عدم تنظیم، ورود مستقیم با شماره تلفن معتبر فعال است)
# AUTH_PIN=your_custom_auth_pin_here

# ۵. فضای ذخیره‌سازی ابری Supabase Storage (الزامی برای ذخیره پایدار بنرها)
# در پنل Supabase یک Bucket عمومی به نام gift-banners ایجاد نمایید
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ۶. شناسه تبلیغات تپسل (اختیاری برای اعتبارسنجی سرور)
TAPSELL_APP_KEY=your_tapsell_app_key_here
TAPSELL_ZONE_ID=your_tapsell_zone_id_here

# ۷. درگاه پیامک کاوه‌نگار (اختیاری - برای ورود دو مرحله‌ای OTP)
# KAVENEGAR_API_KEY=your_kavenegar_api_key_here
